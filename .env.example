# ==========================================
# ClipDrop - Environment Configuration Template
# Copy to .env for local overrides (DO NOT commit secrets)
# ==========================================

# Server Listening Port (Default: 5000)
PORT=5000

# Flask Environment (0 = production, 1 = development)
FLASK_DEBUG=0

# Optional: Explicit custom paths if not using bundled or PATH binaries
# DENO_PATH=/usr/local/bin/deno
# FFMPEG_PATH=/usr/local/bin/ffmpeg
